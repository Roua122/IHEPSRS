# -------------------------------------------------------------------
# Runtime environment â€” non-business deployment settings
# Never commit the real .env file.
# -------------------------------------------------------------------
NODE_ENV=development
APP_VERSION=0.1.2
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
VITE_API_BASE_URL=http://localhost:3000/api

# -------------------------------------------------------------------
# Integration contract version
# Breaking changes require a new major contract version.
# -------------------------------------------------------------------
INTEGRATION_CONTRACT_VERSION=1.0

# -------------------------------------------------------------------
# Versioned/effective-dated business policy document
# Change policy by adding a new version; do not rewrite historical versions.
# -------------------------------------------------------------------
POLICY_CONFIG_PATH=config/policies.json

# -------------------------------------------------------------------
# Mock University
# -------------------------------------------------------------------
MOCK_UNIVERSITY_PORT=3100
CENTRAL_API_URL=http://localhost:3000/api

# -------------------------------------------------------------------
# PostgreSQL local development
# This is DEV-ONLY sample data. Real secrets must not be committed.
# -------------------------------------------------------------------
POSTGRES_DB=ihepsrs
POSTGRES_USER=ihepsrs
POSTGRES_PASSWORD=ihepsrs_dev_only
DATABASE_URL=postgresql://ihepsrs:ihepsrs_dev_only@localhost:5432/ihepsrs

# -------------------------------------------------------------------
# IAM-005 prototype local authentication fallback
# Keep disabled unless trusted SSO is unavailable for the academic demo.
# Do not commit real passwords or TOTP secrets; set them only in local .env.
# -------------------------------------------------------------------
PROTOTYPE_LOCAL_AUTH_ENABLED=false
TRUSTED_SSO_AVAILABLE=false
PROTOTYPE_AUTH_USERNAME=
PROTOTYPE_AUTH_PASSWORD=
PROTOTYPE_AUTH_TOTP_SECRET=
PROTOTYPE_AUTH_USER_ID=
PROTOTYPE_AUTH_PERSON_ID=
PROTOTYPE_AUTH_ROLE_CODE=
PROTOTYPE_AUTH_INSTITUTION_ID=
PROTOTYPE_AUTH_SESSION_PROFILE=SENSITIVE
