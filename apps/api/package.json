{
  "name": "@ihepsrs/api",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "config:check": "node scripts/check-config.cjs",
    "error-model:check": "node scripts/check-error-model.cjs",
    "observability:check": "node scripts/check-observability.cjs",
    "iam001:check": "pnpm build && node scripts/check-iam001.cjs",
    "iam002:check": "pnpm build && node scripts/check-iam002.cjs",
    "iam003:check": "pnpm build && node scripts/check-iam003.cjs",
    "iam004:check": "pnpm build && node scripts/check-iam004.cjs",
    "iam005:check": "pnpm build && node scripts/check-iam005.cjs",
    "research:check": "pnpm build && node scripts/check-research.cjs",
    "publications:check": "pnpm build && node scripts/check-publications.cjs",
    "test": "pnpm iam001:check && pnpm iam002:check && pnpm iam003:check && pnpm iam004:check && pnpm iam005:check && pnpm research:check && pnpm publications:check",
    "auth:generate-totp-secret": "node scripts/generate-totp-secret.cjs"
  },
  "dependencies": {
    "@ihepsrs/contracts": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "6.0.3"
  }
}
