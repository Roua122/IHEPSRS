{
  "name": "ihepsrs",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "predev": "pnpm --filter @ihepsrs/contracts build",
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm --filter @ihepsrs/contracts build && pnpm --filter @ihepsrs/api build && pnpm --filter @ihepsrs/mock-university build && pnpm --filter @ihepsrs/web build",
    "typecheck": "pnpm --filter @ihepsrs/contracts build && pnpm --filter @ihepsrs/api typecheck && pnpm --filter @ihepsrs/mock-university typecheck && pnpm --filter @ihepsrs/web typecheck",
    "test": "pnpm test:smoke",
    "test:smoke": "node scripts/ci-smoke.cjs",
    "quality": "pnpm format:check && pnpm typecheck && pnpm build",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,cjs,mjs,json,css,html}\" \"packages/**/*.{ts,tsx,js,cjs,mjs,json}\" \"scripts/**/*.{js,cjs,mjs}\" \"*.{json,yaml,yml}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,cjs,mjs,json,css,html}\" \"packages/**/*.{ts,tsx,js,cjs,mjs,json}\" \"scripts/**/*.{js,cjs,mjs}\" \"*.{json,yaml,yml}\" \".github/**/*.{yml,yaml}\"",
    "config:check": "pnpm --filter @ihepsrs/api config:check",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
